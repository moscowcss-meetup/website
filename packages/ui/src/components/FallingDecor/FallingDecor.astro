---
import type { HTMLAttributes } from 'astro/types';
import { Snowflake } from '@moscowcss/icons';
import { fall, muted, root, snow, snowTones, spring, springBack, springTones } from './FallingDecor.css';

const Tag = 'div';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Что падает: пружинки или снежинки */
  kind?: 'springs' | 'snow';
}

const { kind = 'springs', class: className, ...attrs } = Astro.props;

const classes = JSON.stringify({ fall, spring, springBack, snow, muted, springTones, snowTones });
---
<Tag class:list={[root, className]} data-falling-decor data-kind={kind} data-classes={classes} aria-hidden="true" {...attrs}>
  <template>
    {kind === 'snow' && <Snowflake />}
  </template>
</Tag>

<script>
  import { setupFallingDecor } from './FallingDecor.client';

  document.querySelectorAll<HTMLElement>('[data-falling-decor]').forEach(setupFallingDecor);
</script>
