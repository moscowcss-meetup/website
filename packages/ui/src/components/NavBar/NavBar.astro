---
import type { HTMLAttributes } from 'astro/types';
import { Close } from '@moscowcss/icons';
import BurgerButton from '../BurgerButton';
import Button from '../Button';
import DecorToggle from '../DecorToggle';
import {
  root,
  bar,
  home,
  links,
  link,
  actions,
  burger,
  closeButton,
  closeIcon,
  telegram,
  meta,
  metaAddress,
  metaToggle,
  overlay,
  overlayLinks,
  overlayLink,
  overlayFooter,
  overlayAddress,
} from './NavBar.css';

const Tag = 'nav';
const MENU_ID = 'nav-menu';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Пункты навигации: якорь и подпись */
  links: { href: string; label: string }[];
  /** URL канала или чата в Telegram */
  telegramHref: string;
  /** Подпись кнопки со ссылкой на Telegram */
  telegramButtonLabel: string;
  /** Подпись чекбокса, который выключает падающие фигуры */
  decorOffLabel: string;
  /** Доступное имя кнопки открытия меню */
  menuLabel: string;
  /** Доступное имя кнопки закрытия меню */
  closeLabel: string;
  /** Адрес главной: логотип слева ведёт на неё; без адреса логотипа нет */
  homeHref?: string;
  /** Доступное имя ссылки на главную */
  homeLabel?: string;
  /** Видимый текст логотипа */
  homeText?: string;
  /** Адрес ближайшего митапа: строка под разделителем и низ меню; без него остаётся только Telegram */
  addressLine?: string;
}

const {
  links: navLinks,
  telegramHref,
  telegramButtonLabel,
  decorOffLabel,
  menuLabel,
  closeLabel,
  homeHref,
  homeLabel,
  homeText,
  addressLine,
  class: className,
  ...attrs
} = Astro.props;

const external = { target: '_blank', rel: 'noopener noreferrer' } as const;
---

<Tag class:list={[root, className]} data-navbar {...attrs}>
  <div class={bar}>
    {
      homeHref && (
        <a class={home} href={homeHref} aria-label={homeLabel}>
          {homeText}
        </a>
      )
    }
    <ul class={links}>
      {
        navLinks.map((item) => (
          <li>
            <a class={link} href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class={actions}>
      {Astro.slots.has('locale') && <slot name="locale" />}
      <div class={telegram}>
        <Button href={telegramHref} size="nav" {...external}>{telegramButtonLabel}</Button>
      </div>
      <div class={burger}>
        <BurgerButton controls={MENU_ID} aria-label={menuLabel} />
      </div>
      <button type="button" class={closeButton} aria-label={closeLabel} data-nav-close>
        <Close class={closeIcon} />
      </button>
    </div>
  </div>
  <div id={MENU_ID} class={overlay} data-nav-menu hidden>
    <ul class={overlayLinks} data-nav-links>
      {
        navLinks.map((item) => (
          <li>
            <a class={overlayLink} href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class={overlayFooter}>
      <DecorToggle label={decorOffLabel} />
      <Button href={telegramHref} size="nav" {...external}>{telegramButtonLabel}</Button>
      {addressLine && <p class={overlayAddress}>{addressLine}</p>}
    </div>
  </div>
</Tag>
<div class={meta}>
  {addressLine && <p class={metaAddress}>{addressLine}</p>}
  <DecorToggle class={metaToggle} label={decorOffLabel} />
</div>

<script>
  import { setupNavBar } from './NavBar.client';

  document.querySelectorAll<HTMLElement>('[data-navbar]').forEach(setupNavBar);
</script>
