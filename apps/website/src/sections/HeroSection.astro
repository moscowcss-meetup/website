---
import TagPile from '@moscowcss/ui/components/TagPile';
import type { CollectionEntry } from 'astro:content';
import { slugOf } from '../content/catalog';
import { eventDateParts, fillTemplate } from '../content/format';
import { useTranslations, type Locale } from '../i18n';
import {
  section,
  inner,
  group,
  stage,
  pile,
  metaRow,
  chip,
  date,
  pastNote,
  day,
  time,
  title,
  modes,
  modeItem,
  about,
  aboutBesideCta,
  lead,
  body,
  dim,
  link,
} from './HeroSection.css';

interface Props {
  // Митап, который показывает блок
  event: CollectionEntry<'events'>;
  locale: Locale;
  // Митап уже прошёл: вместо ссылки на трансляцию — пометка и ссылка на запись
  past: boolean;
  id?: string;
}

const { event, locale, past, id = 'registration' } = Astro.props;
const t = useTranslations(locale);
const { tagline, venue, modes: eventModes, tags, passportRequired, registrationUrl, recordingUrl } = event.data;
const parts = eventDateParts(event.data.date, locale);
const slug = slugOf(event);
// Чип с номером только у пронумерованных митапов; `online-2021` его не получает
const number = /^\d+$/.test(slug) ? slug : undefined;
---

<section class={section} id={id} data-visual="hero">
  <div class={inner}>
    <div class={group}>
      <div class={stage}>
        <TagPile class={pile} tags={[...eventModes, ...tags]} label={t('hero.tags')} />
        <div class={metaRow}>
          {number !== undefined && <span class={chip}>{fillTemplate(t('hero.meetupNumber'), { number })}</span>}
          <p class={date}>
            {past && <span class={pastNote}>{t('hero.pastNote')}</span>}
            <span class={day}>{fillTemplate(t('date.long'), parts)}</span>
            {event.data.time !== undefined && <span class={time}>{fillTemplate(t('hero.time'), { time: parts.time })}</span>}
          </p>
        </div>
      </div>
      <h1 class={title}>{t('hero.title')}</h1>
      <ul class={modes}>
        {eventModes.map((mode) => <li class={modeItem}>{mode}</li>)}
      </ul>
    </div>

    <div class:list={[about, !past && registrationUrl && aboutBesideCta]}>
      <p class={lead}>{tagline}</p>
      <div>
        {venue.address && <p class:list={[body, dim]}>{fillTemplate(t('hero.address'), { address: venue.address })}</p>}
        {passportRequired && <p class:list={[body, dim]}>{t('hero.passport')}</p>}
      </div>
      {
        past ? (
          recordingUrl && (
            <p class={body}>
              <a class={link} href={recordingUrl} target="_blank" rel="noopener noreferrer">
                {t('hero.watchRecording')}
              </a>
            </p>
          )
        ) : (
          <p class={body}>{t('hero.onlineNote')}</p>
        )
      }
    </div>
  </div>
</section>
