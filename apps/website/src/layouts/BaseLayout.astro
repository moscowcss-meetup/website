---
import '@moscowcss/fonts';
import '@moscowcss/design-system';
import '../styles/global.css';
import FallingDecor from '@moscowcss/ui/components/FallingDecor';
import Footer from '@moscowcss/ui/components/Footer';
import NavBar from '@moscowcss/ui/components/NavBar';
import LocaleSwitcher from '@moscowcss/ui/components/LocaleSwitcher';
import {
  defaultLocale,
  locales,
  localeNames,
  localeSwitchHints,
  localizePath,
  useTranslations,
  type Locale,
} from '../i18n';
import { loadCatalog, localeOf, upcomingEvent } from '../content/catalog';
import { buildNow } from '../content/now';
import { CARD_TYPE, OG_SIZE, OG_TYPE, cardMetaOf } from '../seo/og';
import { AI_CATALOG_PATH, ARD_PATH } from '../agents/discovery';
import { markdownPathOf } from '../agents/paths';
import { archiveDataPath } from '../agents/archive-data';
import { feedPath } from '../rss/feed';
import { copyrightOf, footerLinksOf } from './footer';
import { navLinksOf } from './nav';
import SkipLink from '../components/SkipLink.astro';
import { themeInitScript } from '@moscowcss/ui/components/ThemeToggle';
import { jsonLdOf, serializeJsonLd } from '../seo/jsonld';
import { publicPagesOf } from '../seo/pages';

interface Alternate {
  /** Язык версии страницы */
  locale: Locale;
  /** Адрес версии от корня сайта, с хвостовым слэшем */
  path: string;
}

interface Props {
  /** Заголовок страницы: `<title>` */
  title: string;
  /** Описание страницы: meta description */
  description: string;
  /** Язык страницы: `<html lang>` и язык подписей интерфейса */
  lang: Locale;
  /** Версии этой страницы на всех языках: hreflang и переключатель языка */
  alternates: Alternate[];
  /** Закрыть страницу от индексации; canonical у такой страницы не ставится */
  noindex?: boolean;
}

const { title, description, lang, alternates, noindex = false } = Astro.props;
const t = useTranslations(lang);

// Ссылка на Telegram живёт в контенте: pages/<язык>/index.md → telegramUrl.
const catalog = await loadCatalog();
const homePage = catalog.pages.find((entry) => entry.id === `${lang}/index`);
if (!homePage) throw new Error(`Missing page content: pages/${lang}/index.md`);
const { telegramUrl: telegramHref, decor } = homePage.data;

// Адрес в шапке — того же митапа, что показывает главная; без адреса в строке остаётся только чекбокс.
const addressLine = upcomingEvent(
  catalog.events.filter((entry) => localeOf(entry) === lang),
  buildNow(),
)?.event.data.venue.address;

const site = Astro.site;
const absolute = (path: string) => (site ? new URL(path, site).href : path);
// У noindex-страницы canonical нет: «не индексируй» и «вот каноническая версия» противоречат друг другу.
const canonical = noindex ? undefined : absolute(Astro.url.pathname);
// Карточка и тип страницы берутся из общего списка публичных страниц по адресу: у noindex-страницы
// и у адреса вне списка карточки нет, и мета-теги картинки не пишутся.
const publicPage = noindex
  ? undefined
  : publicPagesOf(catalog).find((candidate) => candidate.path === Astro.url.pathname);
const card = publicPage && { ...cardMetaOf(publicPage), type: OG_TYPE[publicPage.kind] };
const ogImage = card && absolute(card.image);
const twitterImage = card && absolute(card.twitterImage);
const jsonLd =
  publicPage &&
  site &&
  jsonLdOf(publicPage, catalog, {
    site,
    siteName: t('site.name'),
    siteDescription: t('site.description'),
    telegramUrl: telegramHref,
    image: ogImage,
  });
const ogLocale: Record<Locale, string> = { ru: 'ru_RU', en: 'en_US' };
const xDefault = alternates.find((alternate) => alternate.locale === defaultLocale);

const navLinks = navLinksOf(lang, t, Astro.url.pathname);

const localeOptions = locales.map((code) => ({
  code,
  label: localeNames[code],
  href: alternates.find((alternate) => alternate.locale === code)?.path ?? localizePath(code),
  hint: localeSwitchHints[code],
  current: code === lang,
}));
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeInitScript} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Pagefind берёт описание для выдачи поиска из этого же тега */}
    <meta name="description" content={description} data-pagefind-meta="description[content]" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={absolute(alternate.path)} />
      ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={card?.type ?? 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:site_name" content={t('site.name')} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content={CARD_TYPE} />
          <meta property="og:image:width" content={String(OG_SIZE.width)} />
          <meta property="og:image:height" content={String(OG_SIZE.height)} />
          <meta property="og:image:alt" content={title} />
        </>
      )
    }
    <meta name="twitter:card" content={twitterImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      twitterImage && (
        <>
          <meta name="twitter:image" content={twitterImage} />
          <meta name="twitter:image:alt" content={title} />
        </>
      )
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault.path)} />}
    <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href={absolute(feedPath(lang))} />
    {publicPage && <link rel="alternate" type="text/markdown" href={absolute(markdownPathOf(publicPage.path))} />}
    {/* Данные списков архива языка: их читает WebMCP-инструмент list_archive */}
    <link rel="alternate" type="application/json" href={archiveDataPath(lang)} data-archive-json />
    <link rel="privacy-policy" href={absolute(localizePath(lang, 'privacy'))} />
    <link rel="ai-catalog" href={absolute(AI_CATALOG_PATH)} />
    <link rel="ard" href={absolute(ARD_PATH)} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body>
    <SkipLink label={t('a11y.skip')} />
    <NavBar
      links={navLinks}
      homeHref={localizePath(lang)}
      homeLabel={t('nav.home')}
      homeText={t('hero.title')}
      telegramHref={telegramHref}
      telegramButtonLabel={t('nav.telegramButton')}
      addressLine={addressLine}
      decorLabel={t(`decor.toggle.${decor}`)}
      decorKind={decor}
      themeLabel={t('theme.dark')}
      menuLabel={t('nav.menu')}
      closeLabel={t('nav.closeMenu')}
      data-visual="navbar"
    >
      <Fragment slot="locale">
        <LocaleSwitcher label={t('locale.label')} options={localeOptions} />
      </Fragment>
    </NavBar>
    <slot />
    <Footer
      homeHref={localizePath(lang)}
      homeLabel={t('nav.home')}
      links={footerLinksOf(lang, t, telegramHref)}
      copyright={copyrightOf(t, buildNow())}
      data-visual="footer"
    />
    <FallingDecor kind={decor} />
  </body>
</html>

<script>
  import { registerSiteTools, type ModelContext } from '../agents/webmcp';

  // Индекс Pagefind появляется только после сборки, поэтому путь не отдаём сборщику на разрешение.
  const PAGEFIND = '/pagefind/pagefind.js';
  const context =
    (document as Document & { modelContext?: ModelContext }).modelContext ??
    (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
  void registerSiteTools(context, {
    location: new URL(window.location.href),
    fetch: (url) => fetch(url),
    loadPagefind: () => import(/* @vite-ignore */ PAGEFIND),
    archiveUrl: document.querySelector<HTMLLinkElement>('link[data-archive-json]')?.href,
  }).catch((error: unknown) => {
    console.error('WebMCP: инструменты не зарегистрированы', error);
  });
</script>
