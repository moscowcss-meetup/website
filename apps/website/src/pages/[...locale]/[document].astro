---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Disclosure from '@moscowcss/ui/components/Disclosure';
import H1 from '@moscowcss/ui/components/H1';
import Prose from '@moscowcss/ui/components/Prose';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPage from '../../components/AboutPage.astro';
import HelpPage from '../../components/HelpPage.astro';
import EntityPage from '../../components/EntityPage.astro';
import { body, header } from '../../components/EntityPage.css';
import { loadCatalog } from '../../content/catalog';
import { useTranslations } from '../../i18n';
import { localeParam, pagesOfKind, publicPagesOf, type PublicPage } from '../../seo/pages';

export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();
  return pagesOfKind(publicPagesOf(catalog), 'document').map((page) => ({
    params: { locale: localeParam(page.locale), document: page.slugParam },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Extract<PublicPage, { kind: 'document' }> };
const { locale, entry, alternates } = page;
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { Content } = await render(entry as any);
const { title, description, topics, contacts, help } = entry.data;
const t = useTranslations(locale);
---

<BaseLayout title={contacts || help ? `${title} — ${t('site.name')}` : title} description={description} lang={locale} alternates={alternates}>
  {help ? <HelpPage entry={entry} locale={locale} /> : contacts ? <AboutPage entry={entry} locale={locale} /> : (
  <EntityPage>
    <div class={header}>
      <H1>{title}</H1>
    </div>
    <Prose class={body}>
      <Content />
    </Prose>
    {
      topics && (
        <Disclosure class={body} summary={topics.summary}>
          <Prose>
            <ul>
              {topics.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </Prose>
        </Disclosure>
      )
    }
  </EntityPage>
  )}
</BaseLayout>
